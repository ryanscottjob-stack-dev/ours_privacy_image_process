{
  "name": "image-process-service",
  "version": "1.0.0",
  "description": "Cloudinary-style HTTP API for resizing, cropping, and converting remote images.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
